# Copy this file to .env.local to change settings while developing.

# Postgres connection string: your Supabase "Transaction pooler" string, with
# your database password in place of [YOUR-PASSWORD]. See "Setting up the
# database (Supabase)" in the README. Leave empty on your own computer to use
# the built-in PGlite database (stored in ./.data). Required on Vercel.
DATABASE_URL=

# Optional: Supabase's SSL certificate (Project Settings > Database > SSL
# configuration), for the strictest check on the encrypted connection.
DATABASE_CA_CERT=

# Time zone used for "today", expiry warnings and daily reports.
APP_TIME_ZONE=America/New_York

# Sign in with Google (optional). Make these in Google Cloud: see
# "Sign in with Google" in the README. If these are empty, the Google
# buttons say Google sign-in isn't switched on yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The site's public address, used for Google's redirect, e.g.
# https://sortmedication.vercel.app. Leave empty on your own computer.
APP_URL=
